{
  "name": "estudearquiteto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "bff",
    "hub-core",
    "shared-types",
    "hub-consumer"
  ],
  "dependencies": {
    "@azure/msal-browser": "^5.6.3",
    "@azure/msal-react": "^5.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "bff": "npm --prefix bff run dev",
    "core": "npm --prefix hub-core run dev",
    "consumer": "npm --prefix hub-consumer run dev",
    "dev": "concurrently \"npm run start\" \"npm run bff\" \"npm run core\" \"npm run consumer\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:4000"
}
